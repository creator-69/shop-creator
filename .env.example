# Copy these values into your hosting provider's environment settings.
NODE_ENV=production
PORT=3000
ADMIN_USERNAME=admin
# Generate a long unique password; never commit your real password.
ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# On Render, mount a persistent disk at /var/data and use these paths:
DATA_DIR=/var/data
UPLOAD_DIR=/var/data/uploads
